{
  "private": true,
  "name": "trees",
  "version": "1.0.0",
  "description": "A gleekit app with trees",
  "scripts": {
    "build": "NODE_ENV=production webpack",
    "compile": "babel $@",
    "start": "webpack serve"
  },
  "gleekit": {
    "name": "Junk",
    "build": {
      "main": {
        "head": [
          {
            "type": "link",
            "url": "dist/styles.css",
            "dev": "src/styles.css"
          },
          {
            "type": "link",
            "url": "https://maxst.icons8.com/vue-static/landings/line-awesome/line-awesome/1.3.0/css/line-awesome.min.css"
          }
        ],
        "body": [
          {
            "type": "script",
            "url": "dist/index.js",
            "dev": "src/index.tsx"
          }
        ]
      }
    }
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/cli": "^7.25.9",
    "@babel/preset-env": "^7.22.14",
    "@babel/preset-typescript": "^7.25.7",
    "@tailwindcss/webpack": "^4.3.3",
    "babel-loader": "^9.1.3",
    "css-loader": "^7.1.2",
    "css-modules-typescript-loader": "^4.0.1",
    "eslint": "^9.39.1",
    "mini-css-extract-plugin": "^2.9.4",
    "prettier": "^3.6.2",
    "sass": "^1.97.1",
    "sass-loader": "^16.0.6",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wallace": "^0.18.0",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "webpack-remove-empty-scripts": "^1.1.1"
  },
  "browser": {
    "crypto": false
  }
}
